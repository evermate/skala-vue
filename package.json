{
  "name": "skala-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "node server.js",
    "dev:all": "concurrently --kill-others-on-fail --names VUE,API --prefix-colors cyan,magenta \"npm run dev\" \"npm run api\"",
    "build": "vite build",
    "build:pages": "vite build --mode pages",
    "preview": "vite preview",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "axios": "^1.19.0",
    "leaflet": "^1.9.4",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "concurrently": "^10.0.4",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.76.0",
    "eslint-plugin-vue": "~10.9.2",
    "globals": "^17.7.0",
    "npm-run-all2": "^9.0.2",
    "oxlint": "~1.76.0",
    "prettier": "3.9.5",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
